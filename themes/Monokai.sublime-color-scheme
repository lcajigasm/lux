{
  "name": "Monokai",
  "globals": {
    "background": "#272822",
    "foreground": "#F8F8F2",
    "accent": "#F92672",
    "selection": "#49483E88",
    "muted": "#75715E",
    "sidebar": "#1E1F1C",
    "tab_bar": "#1E1F1C",
    "tab_inactive": "#34352F",
    "status_bar": "#414339",
    "panel": "#1E1F1C",
    "panel_input": "#414339",
    "panel_row": "#49483E",
    "border": "#3E3D32",
    "gutter": "#272822",
    "line_highlight": "#2C2D27"
  },
  "rules": [
    { "scope": "comment", "foreground": "#75715E" },
    { "scope": "keyword", "foreground": "#F92672" },
    { "scope": "conditional", "foreground": "#F92672" },
    { "scope": "repeat", "foreground": "#F92672" },
    { "scope": "import", "foreground": "#F92672" },
    { "scope": "include", "foreground": "#F92672" },
    { "scope": "string", "foreground": "#E6DB74" },
    { "scope": "character", "foreground": "#E6DB74" },
    { "scope": "charset", "foreground": "#E6DB74" },
    { "scope": "escape", "foreground": "#AE81FF" },
    { "scope": "number", "foreground": "#AE81FF" },
    { "scope": "float", "foreground": "#AE81FF" },
    { "scope": "boolean", "foreground": "#AE81FF" },
    { "scope": "constant", "foreground": "#AE81FF" },
    { "scope": "type", "foreground": "#66D9EF" },
    { "scope": "function", "foreground": "#A6E22E" },
    { "scope": "constructor", "foreground": "#A6E22E" },
    { "scope": "variable", "foreground": "#F8F8F2" },
    { "scope": "parameter", "foreground": "#FD971F" },
    { "scope": "property", "foreground": "#FD971F" },
    { "scope": "attribute", "foreground": "#A6E22E" },
    { "scope": "namespace", "foreground": "#66D9EF" },
    { "scope": "media", "foreground": "#66D9EF" },
    { "scope": "supports", "foreground": "#66D9EF" },
    { "scope": "keyframes", "foreground": "#66D9EF" },
    { "scope": "tag", "foreground": "#F92672" },
    { "scope": "label", "foreground": "#F92672" },
    { "scope": "exception", "foreground": "#F92672" },
    { "scope": "operator", "foreground": "#F92672" },
    { "scope": "punctuation", "foreground": "#8F908A" },
    { "scope": "delimiter", "foreground": "#8F908A" },
    { "scope": "embedded", "foreground": "#F8F8F2" },
    { "scope": "spell", "foreground": "#F8F8F2" },
    { "scope": "text", "foreground": "#F8F8F2" },
    { "scope": "text.title", "foreground": "#A6E22E" },
    { "scope": "text.strong", "foreground": "#FD971F" },
    { "scope": "text.emphasis", "foreground": "#66D9EF" },
    { "scope": "text.literal", "foreground": "#E6DB74" },
    { "scope": "text.uri", "foreground": "#66D9EF" },
    { "scope": "text.reference", "foreground": "#AE81FF" }
  ]
}
